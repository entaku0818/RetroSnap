    "camera.pastelfilm.tagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft pastel colors for portraits and cafe moments."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人物もカフェも、明るくやわらかな淡い色に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인물과 카페에 어울리는 부드러운 파스텔 색감."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanfte Pastellfarben für Porträts und Café-Momente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des tons pastel doux pour les portraits et les instants au café."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonos pastel suaves para retratos y momentos en el café."
          }
        }
      }
    },
