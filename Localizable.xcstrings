    "capture.locked.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shot was taken with a camera you have not purchased, so it was not saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未購入のカメラで撮影したため、この写真は保存されていません。"
          }
        }
      }
    },
