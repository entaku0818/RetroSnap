    "store.error.entitlementMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase went through but the camera did not unlock. Try Restore Purchases, or contact support."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は完了しましたが、カメラが開きませんでした。「購入を復元」をお試しいただくか、お問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매했지만 카메라가 잠금 해제되지 않았습니다. 구매 복원을 시도하거나 지원팀에 문의하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf war erfolgreich, aber die Kamera ist noch gesperrt. Stelle Käufe wieder her oder kontaktiere den Support."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat a réussi, mais la caméra reste verrouillée. Restaurez les achats ou contactez l’assistance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra se completó, pero la cámara sigue bloqueada. Restaura las compras o contacta con soporte."
          }
        }
      }
    },
    "store.error.notConfigured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In-app purchases are unavailable right now. Free cameras still work."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまアプリ内課金を利用できません。無料のカメラはそのまま使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 앱 내 구입을 이용할 수 없습니다. 무료 카메라는 사용할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In-App-Käufe sind derzeit nicht verfügbar. Kostenlose Kameras funktionieren weiterhin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats intégrés sont indisponibles. Les caméras gratuites restent utilisables."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras integradas no están disponibles. Las cámaras gratuitas siguen funcionando."
          }
        }
      }
    },
    "store.error.productsUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load prices. Check your connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格を取得できませんでした。通信状況を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격을 불러오지 못했습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Preise konnten nicht geladen werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les prix. Vérifiez votre connexion et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los precios. Comprueba tu conexión e inténtalo de nuevo."
          }
        }
      }
    },
    "store.error.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase could not be completed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を完了できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매를 완료하지 못했습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht abgeschlossen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat n’a pas pu être effectué."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la compra."
          }
        }
      }
    },
    "store.footer.preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can try every camera in the live preview before buying. A purchase is only needed to save a photo taken with that camera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのカメラもライブプレビューで試せます。購入が必要になるのは、そのカメラで撮った写真を保存するときだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 전에 모든 카메라의 실시간 미리보기를 이용할 수 있습니다. 해당 카메라로 촬영한 사진을 저장하려면 구매가 필요합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste jede Kamera vor dem Kauf in der Live-Vorschau. Der Kauf ist erst nötig, um ein mit dieser Kamera aufgenommenes Foto zu speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez chaque caméra en aperçu avant l’achat. L’achat est nécessaire uniquement pour enregistrer une photo prise avec cette caméra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba cada cámara en la vista previa antes de comprar. Solo necesitas comprarla para guardar las fotos tomadas con ella."
          }
        }
      }
    },
    "store.footer.restore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores cameras you have already bought with this Apple Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Apple アカウントで購入済みのカメラを元に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정으로 구매한 카메라를 복원합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt Kameras wieder her, die du mit diesem Apple Account gekauft hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure les caméras achetées avec ce compte Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura las cámaras compradas con esta cuenta de Apple."
          }
        }
      }
    },
