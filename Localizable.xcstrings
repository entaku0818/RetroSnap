    "camera.heiseidigital.tagline": {
      "comment": "平成デジカメのtagline",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bright flash vibes and a little early-digital grit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白いフラッシュ感と、少し粗いあの頃の写り。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝은 플래시 느낌과 초기 디지털 특유의 질감."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helle Blitzoptik mit dem rauen Charme früher Digitalkameras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un effet flash lumineux et le grain des premiers appareils numériques."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destellos brillantes y la textura de las primeras cámaras digitales."
          }
        }
      }
    },
