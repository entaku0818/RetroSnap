    "capture.locked.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shot was taken with a camera you have not purchased, so it was not saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未購入のカメラで撮影したため、この写真は保存されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매하지 않은 카메라로 촬영하여 사진이 저장되지 않았습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto wurde mit einer nicht gekauften Kamera aufgenommen und nicht gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo n’a pas été enregistrée, car cette caméra n’a pas été achetée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto no se guardó porque se tomó con una cámara que no has comprado."
          }
        }
      }
    },
