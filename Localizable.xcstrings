{
  "sourceLanguage": "en",
  "strings": {
    "icon.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a Photo Icon"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真でアイコンを作る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 아이콘 만들기"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto-Icon erstellen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer une icône photo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear un icono con foto"
          }
        }
      }
    },
    "icon.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your favorite photo in a retro film frame. Save it, then use Shortcuts to add an icon that opens RetroSnap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りの写真をレトロなフィルム枠に。画像を保存して、ショートカットからRetroSnapを開くアイコンを作れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아하는 사진에 레트로 필름 프레임을 씌워 저장하세요. 단축어로 RetroSnap을 여는 아이콘을 추가할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze dein Foto in einen Retro-Filmrahmen. Speichere es und erstelle mit Kurzbefehle ein Icon zum Öffnen von RetroSnap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez votre photo dans un cadre rétro. Enregistrez-la, puis utilisez Raccourcis pour ajouter une icône ouvrant RetroSnap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tu foto en un marco retro. Guárdala y usa Atajos para añadir un icono que abra RetroSnap."
          }
        }
      }
    },
    "icon.preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Screen icon preview"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面アイコンのプレビュー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면 아이콘 미리보기"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau des Home-Bildschirm-Icons"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu de l’icône d’accueil"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa del icono de inicio"
          }
        }
      }
    },
    "icon.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
