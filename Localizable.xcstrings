    "icon.save": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Icon to Photos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンを写真に保存"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 앱에 아이콘 저장"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Icon in Fotos speichern"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer l’icône dans Photos"
