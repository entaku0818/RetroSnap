          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anleitung von Apple"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Guide de configuration Apple"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guía de configuración de Apple"
          }
        }
      }
    },
    "icon.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 열기"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen öffnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les réglages"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ajustes"
          }
        }
      }
    },
    "icon.error.load": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load this photo. Try another photo or download it from iCloud first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を読み込めませんでした。別の写真を選ぶか、iCloudからダウンロードして再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 불러오지 못했습니다. 다른 사진을 선택하거나 먼저 iCloud에서 다운로드하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto konnte nicht geladen werden. Wähle ein anderes oder lade es zuerst aus iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger cette photo. Essayez-en une autre ou téléchargez-la d’abord depuis iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la foto. Prueba otra o descárgala primero de iCloud."
          }
        }
      }
    },
    "icon.error.permission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow RetroSnap to add photos in Settings, then try saving again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でRetroSnapによる写真の追加を許可してから、もう一度保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 RetroSnap의 사진 추가를 허용한 뒤 다시 저장하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube RetroSnap in den Einstellungen das Hinzufügen von Fotos und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez RetroSnap à ajouter des photos dans Réglages, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a RetroSnap añadir fotos en Ajustes y vuelve a guardar."
          }
        }
      }
    },
    "icon.error.save": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save the icon. Check available storage and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンを保存できませんでした。空き容量を確認して再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘을 저장하지 못했습니다. 저장 공간을 확인하고 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Icon konnte nicht gespeichert werden. Prüfe den freien Speicher und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer l’icône. Vérifiez l’espace disponible et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el icono. Comprueba el espacio disponible e inténtalo de nuevo."
          }
        }
      }
    },
    "icon.saved.message": {
