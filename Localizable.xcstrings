        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강한 명암 대비와 흑백 필름의 입자감."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräftige Kontraste und strukturierte Schwarzweißkörnung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des contrastes marqués et un grain noir et blanc texturé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrastes intensos y grano en blanco y negro."
          }
