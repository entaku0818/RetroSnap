    "store.error.productsUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load prices. Check your connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格を取得できませんでした。通信状況を確認してもう一度お試しください。"
          }
        }
      }
    },
    "store.error.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase could not be completed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を完了できませんでした。"
          }
        }
      }
    },
    "store.footer.preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can try every camera in the live preview before buying. A purchase is only needed to save a photo taken with that camera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのカメラもライブプレビューで試せます。購入が必要になるのは、そのカメラで撮った写真を保存するときだけです。"
          }
        }
      }
    },
    "store.footer.restore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores cameras you have already bought with this Apple Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Apple アカウントで購入済みのカメラを元に戻します。"
          }
        }
      }
    },
    "store.free": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料"
          }
        }
      }
    },
