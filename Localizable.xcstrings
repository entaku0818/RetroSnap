    "store.message.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval. The camera unlocks once the purchase is approved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認待ちです。承認されるとカメラが使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인을 기다리고 있습니다. 구매가 승인되면 카메라가 잠금 해제됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf Genehmigung. Danach wird die Kamera freigeschaltet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d’autorisation. La caméra sera débloquée après approbation de l’achat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando aprobación. La cámara se desbloqueará cuando se apruebe la compra."
          }
        }
      }
    },
    "store.message.purchased": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchased. You can save photos with this camera now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入しました。このカメラで保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매했습니다. 이제 이 카메라로 촬영한 사진을 저장할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekauft. Du kannst jetzt Fotos mit dieser Kamera speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat effectué. Vous pouvez enregistrer les photos prises avec cette caméra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra completada. Ya puedes guardar fotos tomadas con esta cámara."
          }
        }
      }
    },
