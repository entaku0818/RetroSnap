// RevenueCat の iOS 公開 SDK キー。
//
// このファイルをコピーして Config/Secrets.xcconfig を作り、値を入れること。
// Secrets.xcconfig は .gitignore で除外してある（履歴に残さない）。
//
//   cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
//
// そのあと Xcode の Project > Info > Configurations で Debug / Release の両方に
// Secrets.xcconfig を割り当てる。
REVENUECAT_API_KEY = REPLACE_ME
