    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Use the camera to take a photo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを使用して写真を撮影します。\n"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라로 사진을 촬영합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze die Kamera, um Fotos aufzunehmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la caméra pour prendre des photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la cámara para hacer fotos."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the photos you take to your photo library"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影した写真を「写真」アプリへ保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영한 사진을 사진 보관함에 저장합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere deine Aufnahmen in der Fotomediathek."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez vos photos dans la photothèque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tus fotos en la fototeca."
          }
        }
      }
    },
    "NSUserTrackingUsageDescription": {
      "comment": "Privacy - Tracking Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This identifier will be used to deliver personalized ads to you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告を適切に表示するために利用します。アプリを無料で運営するためのものです。ご協力お願いします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 식별자는 맞춤형 광고를 제공하는 데 사용됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kennung wird verwendet, um dir personalisierte Werbung zu zeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet identifiant sert à vous proposer des publicités personnalisées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este identificador se usa para mostrarte anuncios personalizados."
          }
        }
      }
    }
  },
  "version": "1.0"
